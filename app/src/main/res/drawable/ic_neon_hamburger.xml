<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Line 1: Neon Cyan -->
    <path
        android:pathData="M3,6 L21,6"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />
    <path
        android:pathData="M5,6 L19,6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- Line 2: Neon Magenta / Violet -->
    <path
        android:pathData="M3,12 L16,12"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="3"
                android:startY="12"
                android:endX="16"
                android:endY="12"
                android:startColor="#FF007F"
                android:endColor="#B026FF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M5,12 L14,12"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- Line 3: Neon Green / Cyan -->
    <path
        android:pathData="M3,18 L21,18"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="3"
                android:startY="18"
                android:endX="21"
                android:endY="18"
                android:startColor="#00FFA3"
                android:endColor="#00F5FF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M5,18 L19,18"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
</vector>
