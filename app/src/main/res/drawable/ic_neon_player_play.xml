<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer Ambient Neon Halo Ring -->
    <path
        android:pathData="M24,24m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
        android:strokeWidth="4.5"
        android:strokeAlpha="0.26"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="44"
                android:endY="44"
                android:startColor="#00F5FF"
                android:centerColor="#B026FF"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>

    <!-- Main Glowing Neon Circle Ring -->
    <path
        android:pathData="M24,24m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
        android:strokeWidth="2.2"
        android:fillColor="#2A12052E">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="44"
                android:endY="44"
                android:startColor="#00F5FF"
                android:centerColor="#B026FF"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>

    <!-- Play Triangle Ambient Glow -->
    <path
        android:pathData="M19.5,14.8 L34.2,24 L19.5,33.2 Z"
        android:strokeWidth="4.0"
        android:strokeAlpha="0.32"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="19"
                android:startY="14"
                android:endX="34"
                android:endY="34"
                android:startColor="#00F5FF"
                android:centerColor="#00FFA3"
                android:endColor="#FFD600" />
        </aapt:attr>
    </path>

    <!-- Play Triangle Neon Tube -->
    <path
        android:pathData="M19.5,14.8 L34.2,24 L19.5,33.2 Z"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="19"
                android:startY="14"
                android:endX="34"
                android:endY="34"
                android:startColor="#00F5FF"
                android:centerColor="#00FFA3"
                android:endColor="#FFD600" />
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="19"
                android:startY="14"
                android:endX="34"
                android:endY="34"
                android:startColor="#4000F5FF"
                android:endColor="#4000FFA3" />
        </aapt:attr>
    </path>

    <!-- Inner Bright White Neon Core -->
    <path
        android:pathData="M21.4,18.2 L30.6,24 L21.4,29.8 Z"
        android:fillColor="#FFFFFF" />
</vector>
