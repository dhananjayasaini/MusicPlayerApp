<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- Rounded Background Disc with Glow -->
    <path
        android:pathData="M24,24m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0"
        android:strokeWidth="2.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="3"
                android:startY="3"
                android:endX="45"
                android:endY="45"
                android:startColor="#00F5FF"
                android:centerColor="#B026FF"
                android:endColor="#FF007F" />
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="21"
                android:startColor="#180B2B"
                android:endColor="#080314" />
        </aapt:attr>
    </path>
    <!-- Left Note Head -->
    <path
        android:pathData="M18.5,31m-3.5,0a3.5,2.8 45,1 1,7 0a3.5,2.8 45,1 1,-7 0"
        android:fillColor="#00F5FF" />
    <path
        android:pathData="M18.5,31m-2,0a2,1.5 45,1 1,4 0a2,1.5 45,1 1,-4 0"
        android:fillColor="#FFFFFF" />

    <!-- Right Note Head -->
    <path
        android:pathData="M29.5,27.5m-3.5,0a3.5,2.8 45,1 1,7 0a3.5,2.8 45,1 1,-7 0"
        android:fillColor="#FF007F" />
    <path
        android:pathData="M29.5,27.5m-2,0a2,1.5 45,1 1,4 0a2,1.5 45,1 1,-4 0"
        android:fillColor="#FFFFFF" />

    <!-- Stems -->
    <path
        android:pathData="M20.5,17 L20.5,30 M31.5,14 L31.5,26.5"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF"
        android:fillColor="#00000000" />

    <!-- Connecting Top Flag -->
    <path
        android:pathData="M19.5,17 L32.5,13.5 L32.5,17 L19.5,20.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="19.5"
                android:startY="17"
                android:endX="32.5"
                android:endY="13.5"
                android:startColor="#00F5FF"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>
</vector>
