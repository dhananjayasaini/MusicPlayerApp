    <!-- Outer Neon Glow Ring (Magenta -> Violet -> Cyan) -->
    <path
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0"
        android:strokeWidth="3"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:startColor="#FF007F"
                android:centerColor="#B026FF"
                android:endColor="#00F5FF" />
        </aapt:attr>
    </path>

    <!-- Inner Neon Cyan Ring -->
    <path
        android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000">
