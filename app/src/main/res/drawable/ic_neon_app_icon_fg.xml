    <path
        android:pathData="M46,40 L67,34 L67,39 L46,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="40"
                android:endX="67"
                android:endY="34"
