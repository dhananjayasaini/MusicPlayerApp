        android:pathData="M62,58m-3.5,0a3.5,2.5 45,1 1,7 0a3.5,2.5 45,1 1,-7 0"
        android:fillColor="#FFFFFF" />

    <!-- Left Stem -->
    <path
        android:pathData="M47.5,40 L47.5,63"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />
    <path
        android:pathData="M47.5,40 L47.5,63"
