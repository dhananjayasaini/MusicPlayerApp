        android:fillColor="#00F5FF" />
    <path
        android:pathData="M44,64m-3.5,0a3.5,2.5 45,1 1,7 0a3.5,2.5 45,1 1,-7 0"
        android:fillColor="#FFFFFF" />

    <!-- Note 2 Head (Right) -->
    <path
        android:pathData="M62,58m-5.5,0a5.5,4.5 45,1 1,11 0a5.5,4.5 45,1 1,-11 0"
        android:fillColor="#FF007F" />
