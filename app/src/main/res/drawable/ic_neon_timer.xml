<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Top button -->
    <path
        android:pathData="M10,2 L14,2 M12,2 L12,5"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#FFD600" />
    <!-- Outer neon ring -->
    <path
        android:pathData="M12,13m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:strokeWidth="1.8"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="5"
                android:endX="20"
                android:endY="21"
                android:startColor="#FFD600"
                android:centerColor="#FFAA1D"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>
    <!-- Clock hands (Electric Cyan) -->
    <path
        android:pathData="M12,13 L12,8 M12,13 L15.5,15.5"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />
    <path
        android:pathData="M12,13m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"
        android:fillColor="#FFFFFF" />
</vector>
