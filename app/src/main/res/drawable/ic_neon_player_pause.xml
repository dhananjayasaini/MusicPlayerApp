<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer Ambient Neon Halo Ring -->
    <path
        android:pathData="M24,24m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
        android:strokeWidth="4.5"
        android:strokeAlpha="0.26"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="44"
                android:endY="44"
                android:startColor="#00F5FF"
                android:centerColor="#B026FF"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>

    <!-- Main Glowing Neon Circle Ring -->
    <path
        android:pathData="M24,24m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
        android:strokeWidth="2.2"
        android:fillColor="#2A12052E">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="44"
                android:endY="44"
                android:startColor="#00F5FF"
                android:centerColor="#B026FF"
                android:endColor="#FF007F" />
        </aapt:attr>
    </path>

    <!-- Pause Bars Ambient Glow (same Cyan -> Mint Green -> Yellow gradient as Play) -->
    <path
        android:pathData="M19,16.5 L19,31.5 M29,16.5 L29,31.5"
        android:strokeWidth="7.0"
        android:strokeAlpha="0.32"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="15"
                android:endX="32"
                android:endY="33"
                android:startColor="#00F5FF"
                android:centerColor="#00FFA3"
                android:endColor="#FFD600" />
        </aapt:attr>
    </path>

    <!-- Pause Bars Neon Tube (same Cyan -> Mint Green -> Yellow gradient as Play) -->
    <path
        android:pathData="M19,16.5 L19,31.5 M29,16.5 L29,31.5"
        android:strokeWidth="4.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="15"
                android:endX="32"
                android:endY="33"
                android:startColor="#00F5FF"
                android:centerColor="#00FFA3"
                android:endColor="#FFD600" />
        </aapt:attr>
    </path>

    <!-- Pause Bars Inner Bright White Neon Core -->
    <path
        android:pathData="M19,17.3 L19,30.7 M29,17.3 L29,30.7"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
</vector>
