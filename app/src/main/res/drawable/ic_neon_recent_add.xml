        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.32">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="8.8"
                android:startY="3.0"
                android:endX="20.4"
                android:endY="18.0"
                android:startColor="#FF1744"
                android:centerColor="#FF3D00"
                android:endColor="#FF6D00" />
        </aapt:attr>
    </path>

    <!-- Top Sparkle Accent (Neon Red-Orange Mix) -->
    <path
        android:pathData="M5.0,3.2 L5.0,7.8 M2.7,5.5 L7.3,5.5"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#FF3D00" />

    <!-- Stems (Red & Dark Orange Neon Mix Gradient) -->
    <path
        android:pathData="M9.6,5.8 L9.6,17.5 M19.6,2.8 L19.6,14.5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
