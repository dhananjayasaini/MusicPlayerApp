        android:pathData="M17.5,15.0m-3.4,0a3.4,2.4 25,1 1,6.8 0a3.4,2.4 25,1 1,-6.8 0"
        android:fillColor="#FF6D00" />
    <path
        android:pathData="M17.5,15.0m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0"
