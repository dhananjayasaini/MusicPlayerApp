        android:pathData="M8.8,5.8 L20.4,2.8 L20.4,6.2 L8.8,9.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8.8"
                android:startY="2.8"
                android:endX="20.4"
                android:endY="9.2"
                android:startColor="#FF1744"
                android:centerColor="#FF3D00"
                android:endColor="#FF6D00" />
        </aapt:attr>
    </path>

    <!-- Left Note Head (Electric Neon Red with White Hot Core) -->
    <path
        android:pathData="M7.5,18.0m-3.4,0a3.4,2.4 25,1 1,6.8 0a3.4,2.4 25,1 1,-6.8 0"
