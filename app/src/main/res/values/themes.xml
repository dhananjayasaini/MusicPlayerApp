<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="splash_screen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>

    <style name="Theme.MusicPlayerApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorPrimaryVariant">@color/theme_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/theme_primary_variant</item>
        <item name="colorOnSecondary">@color/theme_text_primary_light</item>

        <!-- Surface and background colors for Light Mode -->
        <item name="android:colorBackground">@color/theme_bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/theme_text_primary_light</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/theme_text_secondary_light</item>
        <item name="colorSurfaceContainer">@color/theme_surface_variant_light</item>
        <item name="colorSurfaceContainerHigh">@color/theme_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/theme_container_highest_light</item>
        <item name="colorOutline">@color/theme_outline_light</item>
        <item name="colorOutlineVariant">@color/theme_container_high_light</item>
        <item name="android:textColorPrimary">@color/theme_text_primary_light</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary_light</item>
    </style>

</resources>
