<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/bg_widget_preview_practical">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:contentDescription="@string/album_art" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Love Story"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="marquee" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Taylor Swift"
        android:textColor="#A0B0BC"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/widget_btn_fav"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_heart"
            android:contentDescription="@string/nav_favourite" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/previous_song" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_circle_orange"
            android:padding="5dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_pause"
            android:contentDescription="@string/play_pause" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/next_song" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_playlist"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_queue"
            android:contentDescription="@string/title_playlist" />
    </LinearLayout>

</LinearLayout>
