<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_big_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification_container"
    android:padding="12dp">

    <!-- Top Row: Art + Info + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/notif_big_art"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_widget_art"
            android:src="@drawable/music_player_icon_splash_screen"
            android:contentDescription="@string/album_art" />

        <!-- Title & Artist -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/notif_big_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/song_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="marquee" />

            <TextView
                android:id="@+id/notif_big_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist"
                android:textColor="#B09BC9"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Close / Stop Button -->
        <ImageView
            android:id="@+id/notif_big_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_notif_close"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <!-- Middle Row: Waveform Seek Bar + Timers -->
    <LinearLayout
        android:id="@+id/notif_waveform_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Current Time -->
        <TextView
            android:id="@+id/notif_time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#00F5FF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <!-- Dynamic Waveform Seek Bar Image -->
        <ImageView
            android:id="@+id/notif_waveform"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitXY"
            android:contentDescription="Waveform Progress" />

        <!-- Total Time -->
        <TextView
            android:id="@+id/notif_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#A08EBD"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Bottom Row: Controls (Rewind 10s, Prev, Play/Pause, Next, Forward 10s) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <!-- Rewind 10s -->
        <ImageView
            android:id="@+id/notif_btn_rewind"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_notif_rewind_10"
            android:contentDescription="Rewind 10 seconds" />

        <!-- Previous -->
        <ImageView
            android:id="@+id/notif_big_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/previous_song" />

        <!-- Play / Pause -->
        <ImageView
            android:id="@+id/notif_big_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="11dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_widget_play_btn"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/play_pause" />

        <!-- Next -->
        <ImageView
            android:id="@+id/notif_big_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/next_song" />

        <!-- Forward 10s -->
        <ImageView
            android:id="@+id/notif_btn_forward"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_notif_forward_10"
            android:contentDescription="Forward 10 seconds" />

    </LinearLayout>

</LinearLayout>
