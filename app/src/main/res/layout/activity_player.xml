<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".activities.PlayerActivity">

    <LinearLayout
        android:id="@+id/topLayerPA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="10dp"
        tools:ignore="MissingConstraints">

        <ImageButton
            android:id="@+id/backBtnPA"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_btn"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_neon_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/music_player"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/favouriteBtnPA"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/Favourites_btn"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_neon_player_fav_empty" />

        <ImageButton
            android:id="@+id/themeBtnPA"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setting_theme"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_neon_theme" />

        <include
            android:id="@+id/voice_control_pa"
            layout="@layout/voice_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/songImgPA"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/circle_gold_border"
        android:clipToOutline="true"
        android:contentDescription="@string/album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/itunes"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/playerControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayerPA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/songNamePA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/song_title"
            android:textColor="@color/bright_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songAlbumPA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="@string/song_album"
            android:textColor="@color/orange"
            android:textSize="18sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/repeatBtnPA"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/repeat_btn"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_repeat" />

            <ImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/equalizer_btn"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_equalizer" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSleepTimer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/timer_btn"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_neon_timer" />

                <TextView
                    android:id="@+id/txtTimerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_marginTop="-4dp"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="#00F5FF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/shareBtnPA"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share_btn"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_share" />

        </LinearLayout>

        <!-- Seek Bar Row with -10s / +10s and Capsule Timer In/Out Thumb -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRewind10"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 10 seconds"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_replay_10" />

            <com.dhananjaysaini.musicplayerapp.utils.WaveformSeekBar
                android:id="@+id/waveformSeekBarPA"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <ImageButton
                android:id="@+id/btnForward10"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward 10 seconds"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_forward_10" />

            <!-- Hidden for backwards-compatibility -->
            <TextView
                android:id="@+id/startTimePA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/endTimePA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prevBtnPA"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_prev" />

            <ImageButton
                android:id="@+id/playPauseBtnPA"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play/Pause"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_play" />

            <ImageButton
                android:id="@+id/nextBtnPA"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neon_player_next" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
