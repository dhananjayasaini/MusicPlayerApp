<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Folder Icon -->
    <ImageView
        android:id="@+id/folderIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_neon_folder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Name -->
    <TextView
        android:id="@+id/folderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Folder"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/folderIcon"
        app:layout_constraintEnd_toStartOf="@id/playlistMenuIcon"
        app:layout_constraintTop_toTopOf="@id/folderIcon"
        app:layout_constraintBottom_toTopOf="@id/folderCount"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- Sub-text (Count) -->
    <TextView
        android:id="@+id/folderCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0 Song"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/folderIcon"
        app:layout_constraintEnd_toStartOf="@id/playlistMenuIcon"
        app:layout_constraintTop_toBottomOf="@id/folderName"
        app:layout_constraintBottom_toBottomOf="@id/folderIcon"/>

    <ImageView
        android:id="@+id/playlistMenuIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_neon_dots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
