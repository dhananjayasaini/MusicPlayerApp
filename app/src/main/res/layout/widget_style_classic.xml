<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@drawable/bg_widget_preview_classic">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/album_art" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:text="Love Story"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="marquee" />

    <ImageView
        android:id="@+id/widget_btn_fav"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:clickable="true"
        android:src="@drawable/ic_widget_heart"
        android:contentDescription="@string/nav_favourite" />

    <ImageView
        android:id="@+id/widget_btn_prev"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:clickable="true"
        android:src="@drawable/ic_widget_prev"
        android:contentDescription="@string/previous_song" />

    <ImageView
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_circle_orange"
        android:padding="4dp"
        android:clickable="true"
        android:src="@drawable/ic_widget_pause"
        android:contentDescription="@string/play_pause" />

    <ImageView
        android:id="@+id/widget_btn_next"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:clickable="true"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="@string/next_song" />

    <ImageView
        android:id="@+id/widget_btn_playlist"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginStart="6dp"
        android:clickable="true"
        android:src="@drawable/ic_widget_queue"
        android:contentDescription="@string/title_playlist" />

</LinearLayout>
