<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/bg_widget_preview_stylish">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/album_art" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Love Story"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="marquee" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Taylor Swift"
        android:textColor="#B8A6A0"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="35"
        android:progressDrawable="@drawable/bg_widget_progress_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/widget_btn_fav"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_heart"
            android:contentDescription="@string/nav_favourite" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/previous_song" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_widget_circle_orange"
            android:padding="6dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_pause"
            android:contentDescription="@string/play_pause" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/next_song" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_playlist"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:clickable="true"
            android:src="@drawable/ic_widget_queue"
            android:contentDescription="@string/title_playlist" />
    </LinearLayout>

</LinearLayout>
