<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MusicPlayerApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/theme_primary_dark</item>
        <item name="colorPrimaryVariant">@color/theme_primary_variant_dark</item>
        <item name="colorOnPrimary">@color/theme_text_primary_light</item>

        <item name="colorSecondary">@color/theme_primary_dark</item>
        <item name="colorOnSecondary">@color/theme_text_primary_light</item>

        <!-- Surface and background colors for Dark Mode -->
        <item name="android:colorBackground">@color/theme_bg_dark</item>
        <item name="colorSurface">@color/theme_surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/theme_text_secondary_dark</item>
        <item name="colorSurfaceContainer">@color/theme_surface_container_dark</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface_container_high_dark</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface_container_highest_dark</item>
        <item name="colorOutline">@color/theme_outline_dark</item>
        <item name="colorOutlineVariant">@color/theme_outline_variant_dark</item>
        <item name="android:textColorPrimary">@color/theme_text_primary_dark</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary_dark</item>
    </style>

</resources>
